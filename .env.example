NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# Note writes require transactions. Compose initializes a single-node rs0 replica set.
MONGO_URI=mongodb://mongo:27017/helious?replicaSet=rs0
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Required, exactly 64 hexadecimal characters. Never commit your real key.
HELIOUS_MASTER_KEY=
HELIOUS_MASTER_KEY_ID=v1
# Optional JSON map of previous key IDs to 64-hex keys. Keep old keys for backups.
HELIOUS_PREVIOUS_MASTER_KEYS=
PUBLIC_URL=http://localhost:3000
# Set true only behind HTTPS; defaults true in production if omitted.
COOKIE_SECURE=false
REGISTRATION_OPEN=true
# 18 means an unchecked adult self-declaration is required; no DOB/ID is collected.
# 0 disables the declaration for an operator's independently reviewed instance policy.
REGISTRATION_MIN_AGE=18
# Set all three after publishing your own instance's legal pages. No operator data is bundled.
TERMS_VERSION=
TERMS_URL=
PRIVACY_URL=
# Maximum uncompressed bytes per portable account export (default 1 GiB).
ACCOUNT_EXPORT_MAX_BYTES=1073741824
# Optional comma-separated trusted proxy CIDRs; leave empty without a reverse proxy.
TRUST_PROXY=
# Required in production. Verify your sender domain in Resend before sending.
RESEND_API_KEY=
EMAIL_FROM=Helious <noreply@yourdomain.com>
# Optional support/reply mailbox.
EMAIL_REPLY_TO=
